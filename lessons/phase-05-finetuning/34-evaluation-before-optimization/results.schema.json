{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oms/lesson-34/results.schema.json",
  "title": "Lesson 34 deterministic evaluation result",
  "type": "object",
  "required": [
    "schema_version",
    "contract_name",
    "acceptance_sha256",
    "evaluation_config_sha256",
    "evaluator_sha256",
    "predictions_sha256",
    "examples",
    "passed",
    "overall_pass_rate",
    "forbidden_hits",
    "slices",
    "per_example"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_name": {"const": "oms-operations-acceptance-v1"},
    "acceptance_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluation_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluator_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "predictions_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "examples": {"type": "integer", "minimum": 1},
    "passed": {"type": "integer", "minimum": 0},
    "overall_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "forbidden_hits": {"type": "integer", "minimum": 0},
    "slices": {"type": "object"},
    "per_example": {"type": "array", "minItems": 1}
  }
}
