{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/course/rag-document.schema.json",
  "title": "Course RAG source document",
  "type": "object",
  "required": [
    "document_id",
    "version",
    "title",
    "source_uri",
    "license",
    "tenant_ids",
    "published_at",
    "sections"
  ],
  "properties": {
    "document_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "tenant_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    },
    "published_at": {"type": "string", "format": "date"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section_id", "heading", "text"],
        "properties": {
          "section_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "heading": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
