{
  "schema_version": 1,
  "criteria": {
    "behavior_change": "Ability to change response style, format, or learned task behavior",
    "knowledge_freshness": "Ability to incorporate frequently changing knowledge",
    "source_citations": "Ability to expose source evidence with the answer",
    "low_request_latency": "Ability to avoid large per-request context/retrieval overhead",
    "rapid_update": "Ability to update knowledge without retraining weights",
    "access_filtering": "Ability to filter knowledge per caller before generation",
    "small_operations_surface": "Ability to avoid another online data/index service"
  },
