{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/course/lesson-44-results.schema.json",
  "type": "object",
  "required": ["schema_version", "local_api", "study", "update_rollback"],
  "properties": {
    "schema_version": {"const": 1},
    "local_api": {
      "type": "object",
      "required": ["health", "readiness", "authorized_query", "unauthorized_rejected"]
    },
    "study": {
      "type": "object",
      "required": ["contract_id", "variants", "interpretation"]
    },
    "update_rollback": {
      "type": "object",
      "required": [
        "v1",
        "v2",
        "rollback",
        "rollback_exact",
        "rollback_citations_exact"
      ]
    }
  }
}
