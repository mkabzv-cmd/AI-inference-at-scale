{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "imagePullSecrets",
    "nameOverride",
    "fullnameOverride",
    "serviceAccount",
    "app",
    "service",
    "probes",
    "resources",
    "rollout",
    "podAnnotations",
    "podLabels",
    "nodeSelector",
    "tolerations",
    "affinity"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "anyOf": [
            {
              "const": ""
            },
            {
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          ]
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "automountServiceAccountToken"],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "automountServiceAccountToken": {
          "const": false
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "version", "faultMode", "readyDelaySeconds"],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "faultMode": {
          "enum": ["none", "crash", "unready"]
        },
        "readyDelaySeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 300
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {
          "const": "ClusterIP"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "readiness", "liveness"],
      "properties": {
        "startup": {
          "$ref": "#/definitions/probe"
        },
        "readiness": {
          "$ref": "#/definitions/probe"
        },
        "liveness": {
          "$ref": "#/definitions/probe"
        }
      }
    },
    "resources": {
      "$ref": "#/definitions/resources"
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxUnavailable",
        "maxSurge",
        "progressDeadlineSeconds",
        "revisionHistoryLimit"
      ],
      "properties": {
        "maxUnavailable": {
          "$ref": "#/definitions/intOrPercent"
        },
        "maxSurge": {
          "$ref": "#/definitions/intOrPercent"
        },
        "progressDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "revisionHistoryLimit": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "failureThreshold", "periodSeconds"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "$ref": "#/definitions/cpuMemory"
        },
        "limits": {
          "$ref": "#/definitions/cpuMemory"
        }
      }
    },
    "cpuMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "intOrPercent": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^[0-9]+%$"
        }
      ]
    }
  }
}
