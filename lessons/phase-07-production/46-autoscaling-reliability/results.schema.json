{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oms/lesson-46/scaling-study.schema.json",
  "title": "Lesson 46 scaling study",
  "type": "object",
  "required": ["schema_version", "step_seconds", "configuration", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "step_seconds": {"type": "integer", "minimum": 1},
    "configuration": {"type": "object"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "strategy",
          "completed",
          "rejected",
          "p95_wait_steps",
          "scale_actions",
          "timeline"
        ]
      }
    }
  }
}
